{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/prim_reports/browser",
  "rewrites": [
    {
      "source": "/api/session/status",
      "destination": "/api/proxy?action=session-status"
    },
    {
      "source": "/api/session/cookie",
      "destination": "/api/proxy?action=session-cookie"
    },
    {
      "source": "/api/reports/sales/dsr",
      "destination": "/api/proxy?action=report"
    },
    {
      "source": "/traacs/:path*",
      "destination": "/api/proxy?path=/traacs/:path*"
    },
    {
      "source": "/nucorelib/:path*",
      "destination": "/api/proxy?path=/nucorelib/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/api/proxy?path=/css/:path*"
    },
    {
      "source": "/theme/:path*",
      "destination": "/api/proxy?path=/theme/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/api/proxy?path=/js/:path*"
    },
    {
      "source": "/script/:path*",
      "destination": "/api/proxy?path=/script/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "/api/proxy?path=/images/:path*"
    },
    {
      "source": "/img/:path*",
      "destination": "/api/proxy?path=/img/:path*"
    },
    {
      "source": "/plugins/:path*",
      "destination": "/api/proxy?path=/plugins/:path*"
    },
    {
      "source": "/font/:path*",
      "destination": "/api/proxy?path=/font/:path*"
    },
    {
      "source": "/fonts/:path*",
      "destination": "/api/proxy?path=/fonts/:path*"
    }
  ]
}
